# Public URL used by browsers. This value is compiled into the frontend image.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# The exact public URL(s) allowed to call the API. Separate multiple values with commas.
FRONTEND_ORIGIN=https://app.example.com

# Use long, randomly generated values; do not reuse the examples below.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_NAME=attendance_system
DB_USER=attendance_app
DB_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-a-long-random-jwt-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_FOLDER=/app/uploads

# Optional SMTP settings for password reset and notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Attendance System
